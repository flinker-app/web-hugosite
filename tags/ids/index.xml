&lt;!-- DEMO EMBED -->
&lt;style>
 #viewer-demo.viewer-collaboration-frame {
 isolation: isolate;
 padding: 8px;
 border: 2px solid #cbd5e1;
 border-radius: 20px;
 background: #eef2f7;
 box-shadow: 0 20px 50px rgba(15, 23, 42, .14);
 }

 #viewer-demo .viewer-stakeholder {
 position: absolute;
 z-index: 5;
 display: inline-flex;
 align-items: center;
 gap: .15rem;
 color: var(--stakeholder-color);
 pointer-events: none;
 }

 #viewer-demo .viewer-stakeholder svg {
 width: 20px;
 height: 24px;
 flex: 0 0 auto;
 filter: drop-shadow(0 3px 4px rgba(15, 23, 42, .32));
 transform: translateY(-9px) rotate(-4deg);
 }

 #viewer-demo .viewer-stakeholder span {
 display: inline-flex;
 align-items: center;
 gap: .4rem;
 padding: .42rem .72rem;
 border: 2px solid var(--stakeholder-color);
 border-radius: 999px;
 background: #fff;
 color: #0f172a;
 font-size: .78rem;
 line-height: 1;
 font-weight: 700;
 white-space: nowrap;
 box-shadow: 0 7px 18px rgba(15, 23, 42, .2);
 backdrop-filter: blur(8px);
 -webkit-backdrop-filter: blur(8px);
 }

 #viewer-demo .viewer-stakeholder span i {
 color: var(--stakeholder-color);
 font-size: .84rem;
 }

 #viewer-demo .stakeholder-owner { top: 12%; left: 2%; }
 #viewer-demo .stakeholder-design { top: 14%; right: 2%; }
 #viewer-demo .stakeholder-manager { top: 46%; left: 1%; }
 #viewer-demo .stakeholder-contractor { top: 51%; right: 1%; }
 #viewer-demo .stakeholder-asset { bottom: 5%; left: 50%; transform: translateX(-50%); }

 @media (max-width: 575.98px) {
 #viewer-demo .viewer-stakeholder { gap: .15rem; }
 #viewer-demo .viewer-stakeholder svg { width: 14px; height: 18px; transform: translateY(-6px) rotate(-4deg); }
 #viewer-demo .viewer-stakeholder span {
 padding: .3rem .48rem;
 gap: .25rem;
 font-size: .58rem;
 }
 #viewer-demo .viewer-stakeholder span i { font-size: .65rem; }
 #viewer-demo .stakeholder-owner { top: 12%; }
 #viewer-demo .stakeholder-design { top: 15%; }
 }
&lt;/style>
